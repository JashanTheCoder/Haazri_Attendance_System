<%- include('partials/header',{ title: 'Haaज़री - Welcome' }) %>
<link rel="stylesheet" href="/landing.css">

<div class="landing-shell">
    <header class="topbar">
        <div class="container topbar-inner">
            <a href="/" class="brand-word">Haaज़री</a>
            <nav>
                <a href="#features">Features</a>
                <a href="#flow">How It Works</a>
                <a href="/login" class="cta-link">Login</a>
            </nav>
        </div>
    </header>

    <section class="hero">
        <div class="container hero-grid">
            <article class="hero-copy">
                <p class="eyebrow">Attendance planning, reimagined</p>
                <h1>Plan smarter semesters with an impactful attendance dashboard.</h1>
                <p>
                    Stop guessing your safe bunk limit. Haaज़री gives you instant clarity,
                    clear thresholds, and a cleaner workflow for every subject.
                </p>
                <div class="hero-actions">
                    <a href="/login" class="btn-primary">Start Calculating</a>
                    <a href="#flow" class="btn-ghost">See Workflow</a>
                </div>
                <div class="hero-points">
                    <span><i class="fas fa-check-circle"></i> Live percentage insights</span>
                    <span><i class="fas fa-check-circle"></i> Bunk threshold visibility</span>
                    <span><i class="fas fa-check-circle"></i> Action-first dashboard cards</span>
                </div>
            </article>

            <aside class="hero-widget" aria-hidden="true">
                <h3>Semester Snapshot</h3>
                <div class="meter-wrap">
                    <div class="meter-bar"><span></span></div>
                    <p>Current attendance health: <strong>82.4%</strong></p>
                </div>
                <ul>
                    <li><i class="fas fa-arrow-trend-up"></i> 3 subjects above target</li>
                    <li><i class="fas fa-bullseye"></i> 1 subject needs attention</li>
                    <li><i class="fas fa-bolt"></i> Update stats in seconds</li>
                </ul>
            </aside>
        </div>
    </section>

    <section id="features" class="feature-zone">
        <div class="container">
            <p class="eyebrow">Core strengths</p>
            <h2>Everything you need to stay ahead of attendance risk</h2>
            <div class="feature-grid">
                <article>
                    <i class="fas fa-chart-line"></i>
                    <h3>Visual Progress</h3>
                    <p>Track attendance with clear cards and instant status feedback.</p>
                </article>
                <article>
                    <i class="fas fa-calculator"></i>
                    <h3>Smart Limits</h3>
                    <p>See exactly how many classes you can safely miss or must attend.</p>
                </article>
                <article>
                    <i class="fas fa-lightbulb"></i>
                    <h3>Actionable Guidance</h3>
                    <p>Turn percentages into practical next steps for better planning.</p>
                </article>
            </div>
        </div>
    </section>

    <section id="flow" class="flow-zone">
        <div class="container flow-grid">
            <div class="flow-media">
                <img src="back.jfif" alt="Students in campus" />
            </div>
            <div class="flow-copy">
                <p class="eyebrow">How it works</p>
                <h2>From setup to smart decisions in three simple steps</h2>
                <ol>
                    <li>Add your subjects with code, teacher, and course start date.</li>
                    <li>Update delivered and attended lectures periodically.</li>
                    <li>Use the generated status tips to plan each week confidently.</li>
                </ol>
                <a href="/login" class="btn-primary">Open Dashboard</a>
            </div>
        </div>
    </section>

    <footer class="footer">
        <div class="container footer-inner">
            <div>
                <h4 class="brand-word">Haaज़री</h4>
                <p>Helping students master attendance with clarity and confidence.</p>
            </div>
            <div class="footer-links">
                <a href="#features">Features</a>
                <a href="#flow">How It Works</a>
                <a href="/login">Get Started</a>
            </div>
            <div class="social-icons">
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-github"></i></a>
            </div>
        </div>
    </footer>
</div>

<%- include('partials/footer') %>
